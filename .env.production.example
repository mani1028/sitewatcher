# Copy to .env.production on the server (never commit real values).
APP_NAME=SiteWatch
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://sitewatch:change-me-db-pass@postgres:5432/sitewatch
POSTGRES_PASSWORD=change-me-db-pass
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=https://sitewatch.example.com
MAX_CONCURRENT_CHECKS=20
SCHEDULER_TICK_SECONDS=10
DEFAULT_CHECK_INTERVAL=60
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
SLOW_THRESHOLD_MS=2000
CHECK_RETENTION_DAYS=1
CHECK_RETENTION_PER_SITE=24
NOTIFICATION_RETENTION=50
FAILED_EMAIL_RETENTION_DAYS=3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SiteWatch <alerts@example.com>
SMTP_USE_TLS=true
ALERT_EMAIL=you@example.com
NOTIFICATIONS_ENABLED=true
