# Application
APP_NAME=SiteWatch
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Database
DATABASE_URL=postgresql+asyncpg://sitewatch:sitewatch@postgres:5432/sitewatch

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
FRONTEND_URL=http://localhost:3000

# Monitoring
MAX_CONCURRENT_CHECKS=20
SCHEDULER_TICK_SECONDS=10
DEFAULT_CHECK_INTERVAL=60
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
SLOW_THRESHOLD_MS=2000
CHECK_RETENTION_DAYS=7

# SMTP sender (Gmail example). Recipients = ALERT_EMAIL (comma-separated) or Settings UI.
# Port 587 tries STARTTLS; if it fails, 465 SSL is tried automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SiteWatch <alerts@gmail.com>
SMTP_USE_TLS=true
ALERT_EMAIL=you@company.com, teammate@company.com
NOTIFICATIONS_ENABLED=true
